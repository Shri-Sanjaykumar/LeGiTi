# ==============================================================================
# LEGITIFY / LeGiTi ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file to .env.local and populate with your credentials.
# cp .env.example .env.local
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & API Ports
# ------------------------------------------------------------------------------
PORT=3001
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. Database & Storage (Supabase & Neon PostgreSQL)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key_here
SUPABASE_STORAGE_BUCKET=legitify-files

# Direct PostgreSQL Connection URL (Neon or Supabase)
DATABASE_URL=postgresql://neondb_owner:your_password@your-host.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Google Gemini AI (Investigation & Grounding)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_AI_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Cybersecurity Threat Intelligence Feeds (VirusTotal, AbuseIPDB, Safe Browsing)
# ------------------------------------------------------------------------------
# VirusTotal v3 API (Domain, URL, and File Reputation)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB v2 API (IP Abuse Confidence & Reporting)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Google Safe Browsing API v4 (Malicious URL and Social Engineering Detection)
SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# ------------------------------------------------------------------------------
# 5. Hugging Face Models & S3 Storage
# ------------------------------------------------------------------------------
HF_TOKEN=your_hugging_face_api_token_here
HF_MODEL=Qwen/Qwen3-8B
HF_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct

# Hugging Face S3 Endpoint (Optional)
AWS_ACCESS_KEY_ID=your_hf_s3_access_key
AWS_SECRET_ACCESS_KEY=your_hf_s3_secret_key
ENDPOINT_URL=https://s3.hf.co/your-username

# ------------------------------------------------------------------------------
# 6. High-Performance Caching (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ------------------------------------------------------------------------------
# 7. OAuth Authentication (Google & GitHub)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 8. Notifications & Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
